{
  "name": "fallenangel-launcher",
  "version": "0.1.0",
  "description": "Minecraft offline launcher built with Electron",
  "main": "src/main/index.ts",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"electron .\"",
    "build": "tsc",
    "package": "electron-builder",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron": "^28.0.0",
    "fs-extra": "^11.1.0",
    "launchdarkly-node-server-sdk": "^6.0.0",
    "minecraft-launcher-core": "^3.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "electron-builder": "^24.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.fallenangel.launcher",
    "productName": "FallenAngel Launcher",
    "files": [
      "dist/**/*",
      "resources/**/*",
      "node_modules/**/*"
    ]
  }
}