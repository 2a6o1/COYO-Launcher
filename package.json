{
  "name": "fallenangel-launcher",
  "version": "0.1.0",
  "description": "Minecraft offline launcher built with Electron",
  "main": "src/main/index.ts",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"wait-on dist/index.js && electron .\"",
    "build": "tsc",
    "start": "npm run build && electron .",
    "package": "electron-builder",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' --fix || true"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "@xmcl/core": "^2.15.0",
    "axios": "^1.6.0",
    "fs-extra": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "@types/electron": "^28.0.0",
    "typescript": "^5.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^8.0.0",
    "wait-on": "^7.0.0",
    "jest": "^29.0.0"
  },
  "build": {
    "appId": "com.fallenangel.launcher",
    "productName": "FallenAngel Launcher",
    "files": [
      "dist/**/*",
      "resources/**/*",
      "node_modules/**/*"
    ]
  }
}